#+LATEX_HEADER: \lstdefinelanguage{yaml}{sensitive=false,morecomment=[l]{\#},morestring=[b]"}
# Speech blocks for the teacher notes:  #+begin_en ... #+end_en / #+begin_fr ... #+end_fr
#+LATEX_HEADER: \newtcolorbox{en}{colback=blue!3,colframe=blue!45!black,boxrule=0.5pt,left=4pt,right=4pt,top=9pt,bottom=3pt,title={\textbf{EN}},fonttitle=\small,attach boxed title to top left={yshift=-2mm,xshift=3mm},boxed title style={size=small,colback=blue!45!black},enhanced,breakable}
#+LATEX_HEADER: \newtcolorbox{fr}{colback=red!2,colframe=red!50!black,boxrule=0.5pt,left=4pt,right=4pt,top=9pt,bottom=3pt,title={\textbf{FR}},fonttitle=\small,attach boxed title to top left={yshift=-2mm,xshift=3mm},boxed title style={size=small,colback=red!50!black},enhanced,breakable}
# Generic boxes: #+begin_tip, #+begin_question, #+begin_why
